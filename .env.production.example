# Production hardening for zoop-cloud
# Copy to .env or export before running ./bin/zoop-cloud
# See packages/core/config/config.go and packages/cloud/api/middleware.go

# Required in production: otherwise all /v1/admin/* return 403 "ZOOP_ADMIN_IDS not configured"
ZOOP_ENV=production
ZOOP_ADMIN_IDS=be9b2660-1a09-58ee-bb70-572663752088,41105810-7541-5613-9790-bd11b1b425e5  # your device endpoint_ids (uuid.NewSHA1(pub))
ZOOP_WEB_DIST=./web/dist
ZOOP_DATABASE_URL=postgres://zoop:zoop@localhost:5432/zoop?sslmode=disable
# Generate with: openssl rand -hex 32
ZOOP_TURN_SECRET=fa655682b55f50c8a7933dc224c1d4a5b13ee33d048cefa71d725b6dba316ecf
ZOOP_TURN_REALM=zoop.network
ZOOP_ALLOWED_ORIGINS=https://zoop.network,https://cloud.zoop.network
VITE_HIDE_DEV_ADMIN=true
