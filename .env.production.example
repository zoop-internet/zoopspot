# Production configuration for zoop-cloud
# Copy to .env or export before running ./bin/zoop-cloud or docker compose
# See packages/core/config/config.go and packages/cloud/api/middleware.go

ZOOP_ENV=production

# ─── Database Configuration (Neon.tech or Self-Hosted) ──────────────────────
# For Neon Serverless Postgres:
# Paste your Neon connection string (either pooled or direct).
# channel_binding=require is automatically sanitized by zoop-cloud for lib/pq compatibility.
ZOOP_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Alternatively, if running local PostgreSQL:
# ZOOP_DATABASE_URL=postgres://zoop:zoop_prod_password@localhost:5432/zoop_db?sslmode=disable

# ─── Redis Configuration ───────────────────────────────────────────────────
# Ephemeral session cache and pub/sub signaling.
# When running on the same VM via Docker:
ZOOP_REDIS_URL=redis://localhost:6379

# ─── Security & RBAC ───────────────────────────────────────────────────────
# Device endpoint IDs (uuid.NewSHA1(pubKey)) allowed access to /v1/admin/*
ZOOP_ADMIN_IDS=be9b2660-1a09-58ee-bb70-572663752088,41105810-7541-5613-9790-bd11b1b425e5

# CORS allowed origins (e.g. your Cloudflare Pages domain and custom domains)
ZOOP_ALLOWED_ORIGINS=https://zoop.network,https://app.zoop.network,https://*.pages.dev

# ─── STUN / TURN (Coturn) ─────────────────────────────────────────────────
# Generate secret with: openssl rand -hex 32
ZOOP_TURN_SECRET=fa655682b55f50c8a7933dc224c1d4a5b13ee33d048cefa71d725b6dba316ecf
ZOOP_TURN_REALM=zoop.network
ZOOP_STUN_SERVER=stun.zoop.network:3478

# ─── Audit Log Integrity ──────────────────────────────────────────────────
# HMAC-SHA256 secret for the cryptographic audit log chain.
# Required to enable audit chain integrity. Generate with: openssl rand -hex 32
ZOOP_AUDIT_HMAC_KEY=your-random-64-char-hex-secret-here

# ─── Web Console (Optional SPA File Serving) ────────────────────────────────
# If serving SPA directly from zoop-cloud (otherwise leave blank if hosted on Cloudflare Pages)
# ZOOP_WEB_DIST=./web/dist
VITE_HIDE_DEV_ADMIN=true

