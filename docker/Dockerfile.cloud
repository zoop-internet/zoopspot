FROM golang:1.25-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/zoop-cloud ./cloud

FROM alpine:3.19
RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=builder /bin/zoop-cloud /bin/zoop-cloud

EXPOSE 8080
ENTRYPOINT ["/bin/zoop-cloud"]
