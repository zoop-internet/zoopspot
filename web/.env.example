# Zoop Web App build-time configuration
#
# Copy to .env and adjust. These values are baked in at build time (Vite).
#
# Control plane base URL. Leave unset to use the Vite dev proxy (/api → http://localhost:8080).
# For a deployed web app pointing at a remote control plane, set the full origin,
# e.g. https://cloud.zoopnetwork.app
# VITE_API_BASE=

# Releases base for download matrix. When set, Download buttons open real binaries.
# e.g. https://github.com/zoop-internet/zoop/releases/download/v0.1.0
# VITE_RELEASES_BASE=

# Waitlist endpoint for Pricing founding list. When set, form POSTs JSON {email,source,plan}.
# e.g. https://api.zoopnetwork.app/v1/waitlist or Cloudflare Worker KV endpoint
# VITE_WAITLIST_URL=

# Local daemon base (zoopd on 127.0.0.1:9090, http only). From https:// pages mixed-content blocks http fetches;
# develop via http://localhost:5173 or set an https-terminated tunnel URL here.
# VITE_DAEMON_BASE=http://127.0.0.1:9090

# Hide DEV→Admin floating button in production
# VITE_HIDE_DEV_ADMIN=true